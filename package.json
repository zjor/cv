  "license": "ISC",
  "bugs": {
    "url": "https://github.com/zjor/cv/issues"
  },
  "homepage": "https://github.com/zjor/cv#readme",
  "dependencies": {
    "handlebars": "^4.1.2",
    "html-pdf": "^3.0.1",
    "js-yaml": "^3.14.1",
    "phantomjs-prebuilt": "^2.1.16"
  }
}
